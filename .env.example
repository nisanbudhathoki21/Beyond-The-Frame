# Auth / Security (set in production, never commit real values)
JWT_SECRET="change-this-to-a-64-char-random-string-in-production"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2a$12$examplehashreplaceonsetup"
SESSION_COOKIE_NAME="nls_session"
CSRF_COOKIE_NAME="nls_csrf"

# Database (PostgreSQL in production, SQLite for local demo)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/nepallens?schema=public"

# Uploads
MAX_UPLOAD_MB="10"
ALLOWED_UPLOAD_MIMES="image/jpeg,image/png,image/webp,image/avif,video/mp4,video/webm"
